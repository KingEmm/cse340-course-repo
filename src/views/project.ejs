<%- include('partials/header') %>
<main>
    <section class="hero">
        <h1><%= title %></h1>
        <a href="/organization/<%= projectDetails.organization_id %>" target="_blank" rel="noopener noreferrer"><strong><%= projectDetails.name %></strong></a>
        <p><%= projectDetails.description %></p>
        <p>
            Location: <%= projectDetails.location %><br>
            Project Date: <%= new Date(projectDetails.project_date).toDateString() %><br>
        </p>
        <a href="/assign-category/<%= projectDetails.project_id %>">Edit Categories</a><br>
        <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project Details</a>
    </section>


<%- include('partials/footer') %>