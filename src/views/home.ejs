<%- include('partials/header') %>
<main>
    <section class="hero">
        <img loading="lazy" src="/images/serve.jpg" alt="Lady serving" width="50" height="50">
        <h1><%= title %></h1>
        <p>Welcome to the CSE 340 Service Network — your landing page for discovering community organizations, purposeful projects, and service categories built for real impact.</p>
    </section>

    <section class="intro">
        <h2>Explore, connect, and contribute</h2>
        <p>Browse organizations looking for student collaborators, learn which projects are shaping communities, and find the service category that matches your passion. This site is designed to help you turn coursework into meaningful service.</p>
    </section>

    <section class="navigation-highlights">
        <div class="feature">
            <h3>Organizations</h3>
            <p>View local teams, partners, and groups driving each initiative. Learn who is behind the work and how they’re making a difference.</p>
        </div>
        <div class="feature">
            <h3>Projects</h3>
            <p>Discover current and upcoming projects with clear goals, timelines, and opportunities for involvement.</p>
        </div>
        <div class="feature">
            <h3>Categories</h3>
            <p>Filter projects by service type like education, technology, sustainability, and community outreach to find what fits your interests.</p>
        </div>
    </section>

    <section class="call-to-action">
        <h2>Ready to get started?</h2>
        <p>Use the menu above to explore Organizations, Projects, or Categories. The CSE 340 Service Network is your gateway to collaborate, learn, and create impact.</p>
    </section>
</main>
<%- include('partials/footer') %>