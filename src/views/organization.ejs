<%- include('partials/header') %>
<main>
    <section class="hero">
        <h1><%= title %></h1>
        <p><%= organization.description %></p>
        <p>
            Contact: 
            <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
        </p>
        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> Logo" loading="lazy" width="50" height="50">
    </section>
    <h2>Current Projects</h2>
       <section class="navigation-highlights">
        <% projects.forEach(project => { %>
            <a href="/project/<%= project.project_id %>" class="feature">
                <h3><%= project.title %></h3>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><strong>Project Date:</strong> <%= project.project_date %></p>
            </a>
        <% }); %>
        </section>


<%- include('partials/footer') %>