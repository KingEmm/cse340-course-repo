<%- include('partials/header') %>
<main>
    <section class="hero">
        <h1><%= title %></h1>
        <p>Explore active and upcoming projects that invite student participation, collaboration, and community impact.</p>
    </section>

    <section class="intro">
        <h2>Projects with purpose</h2>
        <p>Each project is designed to address a specific challenge or opportunity. Learn the goals, expected outcomes, and how you can contribute your skills.</p>
    </section>

    <div>Project Id: <%- projects[1].project_id %></div>

    <section class="navigation-highlights">
        <% projects.forEach(project => { %>
            <a href="/project/<%= project.project_id %>" class="feature">
                <h3><%= project.title %></h3>
                <strong><%= project.name %></strong><br>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><strong>Project Date:</strong> <%= project.project_date %></p>
            </a>
        <% }); %>
        <!-- <div class="feature">
            <h3>Design & Development</h3>
            <p>Work on websites, apps, and digital experiences that support mission-driven programs and services.</p>
        </div>
        <div class="feature">
            <h3>Research & Strategy</h3>
            <p>Engage in discovery, planning, and analysis to shape effective service solutions.</p>
        </div>
        <div class="feature">
            <h3>Community Outreach</h3>
            <p>Help coordinate activities, communication, and volunteer initiatives with local stakeholders.</p>
        </div> -->
    </section>

    <section class="call-to-action">
        <h2>Get involved</h2>
        <p>Browse available projects, match your interests to the right teams, and start making meaningful contributions.</p>
    </section>
</main>
<%- include('partials/footer') %>