<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/add-category" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required 
        maxlength="100"
      />
    </div>

    <button type="submit">Add Category</button>
  </form>

</main>
<%- include('partials/footer') %>