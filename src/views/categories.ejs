<%- include('partials/header') %>
<main>
    <section class="hero">
        <h1><%= title %></h1>
        <p>Find the service areas that match your interests and academic goals. Browse categories designed to help you choose the right project path.</p>
    </section>

    <section class="intro">
        <h2>Service categories for focused impact</h2>
        <p>Each category represents a different way to serve the community. Whether you’re passionate about education, sustainability, technology, or outreach, this page helps you find the best fit.</p>
    </section>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/add-category">Add Category</a>
    <% } %>
    <section class="navigation-highlights">
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>" class="feature">
                <h3><%= category.name %></h3>
            </a>
        <% }); %>
    </section>

    <section class="call-to-action">
        <h2>Choose your focus</h2>
        <p>Start by identifying the category that most inspires you, then explore matched organizations and projects across the site.</p>
    </section>
</main>
<%- include('partials/footer') %>