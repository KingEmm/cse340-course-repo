<%- include('partials/header') %>
<style>
    body {
        background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 45%, #ffffff 100%);
    }

    main {
        padding: 28px 24px 56px;
        max-width: 1024px;
    }

    .hero {
        background: radial-gradient(circle at top left, rgba(99,102,241,0.18), transparent 45%),
                    linear-gradient(180deg, #eef2ff 0%, #ffffff 100%);
        border-color: rgba(99,102,241,0.28);
        color: #1e3a8a;
        text-shadow: 0 1px 1px rgba(255,255,255,0.7);
    }

    .hero h1 {
        color: #111827;
    }

    .organization-highlights {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .feature {
        border-left: 5px solid #4f46e5;
        background: rgba(255,255,255,0.96);
        border-color: rgba(79,70,229,0.18);
        box-shadow: inset 0 0 0 1px rgba(79,70,229,0.05);
        margin: 1rem;
        display: grid;
        grid-template-columns: 27% 70%;
        column-gap: 3%;
        & img{
            width: 100%;
            grid-row: 1 / span 3;
            border-radius: .5rem;
        }
        & h3 {
            color: #4338ca;
        }
    }


    .intro {
        border-color: rgba(99,102,241,0.18);
    }

    .call-to-action {
        border-color: rgba(147,197,253,0.35);
        background: #eff6ff;
    }

    @media (max-width: 860px) {
        .organization-highlights {
            grid-template-columns: 1fr;
        }
    }
</style>
<main id="main-content">
    <section class="hero">
        <h1><%= title %></h1>
        <p>Explore the organizations currently seeking CSE 340 student partners for service-driven technology and community projects.</p>
    </section>

    <section class="intro">
        <h2>Purpose-driven collaborators</h2>
        <p>Each organization listed here has a real mission and specific needs. Learn how they apply technology, design, and service to solve local problems and support community goals.</p>
    </section>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-organization">Add a new organization +</a></p>
    <% } %>

    <section class="organization-highlights">
        <% organizations.forEach(organization => { %>
            <div class="feature">
                <img loading="lazy" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> Logo">
                <a class="" href="/organization/<%= organization.organization_id %>"><h3><%= organization.name %></h3></a>
                <p><%= organization.description %></p>
                <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
            </div>
        <% }); %>
    </section>

    <section class="call-to-action">
        <h2>Choose a partner organization</h2>
        <p>Review each organization’s goals, current projects, and collaboration opportunities to find the best fit for your skills and interests.</p>
    </section>
</main>
<%- include('partials/footer') %>