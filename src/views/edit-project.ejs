<%- include('partials/header') %>
<main id="main-content" class="page-content">
    <h1><%= title %></h1>

 <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        required 
        maxlength="150"
        value="<%= projectDetails.title %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
          maxlength="500"
          required 
      ><%= projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        required
        value="<%= projectDetails.location %>"
      />
    </div>

    <div class="form-group">
      <label for="project_date">Project Date</label>
      <input
        type="date"
        id="project_date"
        name="date"
        required
        value="<%= new Date(projectDetails.project_date).toISOString().split('T')[0] %>"
      />
    </div>

    <div class="form-group">
      <label for="organization_id">Organization</label>
      <select id="organization_id" name="organizationId" required>
        <!-- <option value="">Select an organization</option> -->
        <option value="<%= projectDetails.organization_id %>" selected><%= projectDetails.name %> Default</option>
        <% organizations.forEach((org) => { %>
          <option value="<%= org.organization_id %>"><%= org.name %></option>
        <% }); %>
        <!-- default value for organization -->
      </select>
    </div>
</div>

    <button type="submit">Update Project</button>
  </form>

</main>
<%- include('partials/footer') %>